{
  "name": "week-07-npm-node-boilerplate",
  "version": "1.0.0",
  "description": "Node.js project boilerplate demonstrating npm scripts, linting, formatting, and environment configuration.",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "build": "node --check src/index.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "eslint": "^9.36.0",
    "prettier": "^3.6.2"
  }
}
